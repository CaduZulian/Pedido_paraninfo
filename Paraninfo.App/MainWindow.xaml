<Window x:Class="Paraninfo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Paraninfo.App.Views"
        Title="Paraninfo" Width="1180" Height="760" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="Black"
        PreviewKeyDown="Window_KeyDown" UseLayoutRounding="True">
    <Grid Background="#090F0C">
        <views:TerminalView x:Name="Terminal">
            <views:TerminalView.RenderTransform>
                <TranslateTransform/>
            </views:TerminalView.RenderTransform>
        </views:TerminalView>
        <Grid x:Name="FinalLayout" Visibility="Collapsed" Background="#090F0C"
              TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="FinalPhosphor" Width="1280" Height="720">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="42"/>
                    </Grid.RowDefinitions>
                    <Border Background="#102019" BorderBrush="#254F39" BorderThickness="0,0,0,1" Padding="24,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PhaseLabel" DockPanel.Dock="Right" FontSize="21" Foreground="{StaticResource MutedGreenBrush}"/>
                            <TextBlock Text="&gt;_  academic@cc:~ / paraninfo.exe" FontSize="24"/>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" Margin="28,18" ClipToBounds="True">
                        <views:InvitationView x:Name="Invitation" Visibility="Collapsed"/>
                        <views:CelebrationView x:Name="Celebration" Visibility="Collapsed"/>
                    </Grid>
                    <TextBlock x:Name="KeysLabel" Grid.Row="2" Margin="28,0" FontSize="21"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedGreenBrush}"/>
                </Grid>
            </Viewbox>
            <views:CrtOverlay x:Name="FinalCrt"/>
        </Grid>
        <views:GlitchView x:Name="Effects"/>
        <Border x:Name="Blackout" Background="Black" Opacity="0" IsHitTestVisible="False"/>
    </Grid>
</Window>
