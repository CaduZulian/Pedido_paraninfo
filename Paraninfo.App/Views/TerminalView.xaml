<UserControl x:Class="Paraninfo.App.Views.TerminalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Paraninfo.App.Views"
             TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Border CornerRadius="0" BorderThickness="0" Background="#090F0C" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Chrome simulado inspirado no Windows Terminal; não controla janelas do sistema. -->
            <Border Background="#102019" BorderBrush="#254F39" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="140"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#090F0C" CornerRadius="7,7,0,0" Margin="8,7,0,-1" Padding="16,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock DockPanel.Dock="Right" Text="×" FontFamily="Segoe UI" FontSize="18" Foreground="{StaticResource MutedGreenBrush}"/>
                            <TextBlock Text="&gt;_" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,14,0"/>
                            <TextBlock Text="PowerShell" FontFamily="Segoe UI" FontSize="15"/>
                        </DockPanel>
                    </Border>
                    <TextBlock Grid.Column="1" Text="+   ⌄" FontFamily="Segoe UI" FontSize="19"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="—      □      ×" FontFamily="Segoe UI" FontSize="16"
                               VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource MutedGreenBrush}"/>
                </Grid>
            </Border>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" Margin="20,18,16,14" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel x:Name="PhosphorText">
                    <TextBlock x:Name="ShellVersion" FontSize="26" Foreground="{StaticResource MutedGreenBrush}"/>
                    <TextBlock Text="Academic session initialized. All modules run locally."
                               FontSize="24" Foreground="{StaticResource MutedGreenBrush}" Margin="0,6,0,20"/>
                    <TextBlock x:Name="Prompt" FontSize="28" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,14"/>
                    <TextBlock FontSize="28" LineHeight="32" TextWrapping="Wrap"><Run x:Name="Output"/><InlineUIContainer BaselineAlignment="TextBottom">
                        <Rectangle Width="12" Height="22" Fill="{StaticResource AccentBrush}" Margin="2,0,0,0">
                            <Rectangle.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:1">
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="1"/>
                                                <DiscreteDoubleKeyFrame KeyTime="0:0:0.5" Value="0"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Rectangle.Triggers>
                        </Rectangle>
                    </InlineUIContainer></TextBlock>
                </StackPanel>
            </ScrollViewer>
            <local:CrtOverlay x:Name="Crt" Grid.RowSpan="2"/>
        </Grid>
    </Border>
</UserControl>
